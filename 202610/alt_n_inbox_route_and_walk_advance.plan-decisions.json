      "kind": "choice",
      "ask": "Should Alt+N advance the walk from any due walk row, not only the exact `]s` landing?",
      "why": "It is the rule you stated; both missed Alt+N advances on 10-31 were due rows off the landing",
      "choices": [
        {
          "key": "due_row",
          "label": "Reworded or hand-reached due rows advance too; a daytime Alt+N on one jumps away"
        },
        {
          "key": "landing",
          "label": "Only the exact `]s` landing advances, as today; only the inbox routing ships"
        }
      ],
      "default": "due_row",
      "effective_default": "due_row",
      "requested_verified": false
