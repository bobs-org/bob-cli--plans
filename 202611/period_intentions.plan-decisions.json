    {
      "id": "day_summary_cap",
      "kind": "choice",
      "ask": "Should a daily summary allow 1\u20133 sentences of up to 60 words?",
      "why": "A day has no Review, so its summary carries the whole closeout.",
      "choices": [
        {
          "key": "sixty",
          "label": "1\u20133 sentences, at most 60 words, one paragraph, at most 2 links; week tables clip it with a tooltip"
        },
        {
          "key": "one_line",
          "label": "One line of at most 25 words, the same cap as week, quarter, and year summaries"
        }
      ],
      "default": "sixty",
      "effective_default": "sixty",
      "requested_verified": false
    },
