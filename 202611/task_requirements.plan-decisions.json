{
  "schema": 1,
  "definitions": [
    {
      "id": "notes_drawer_birth",
      "kind": "choice",
      "ask": "When should a task that has requirements grow its NOTES drawer?",
      "why": "Keeps the drawer contract (nonempty by construction) and avoids bare headers",
      "choices": [
        {
          "key": "with_first_note",
          "label": "When it first has a note to hold, so drawers are never empty"
        },
        {
          "key": "with_first_req",
          "label": "As soon as its first requirement lands, even if NOTES starts empty"
        }
      ],
      "default": "with_first_note",
      "effective_default": "with_first_note",
      "requested_verified": false
    },
    {
      "id": "seed_review",
      "kind": "toggle",
      "ask": "Should the migration also prepare an opt-in list of loose notes that read like requirements?",
      "why": "You already write requirements as plain bullets; nothing converts without approval",
      "default": true,
      "effective_default": true,
      "requested_verified": false
    },
    {
