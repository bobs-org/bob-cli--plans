    {
      "id": "settled_status",
      "kind": "choice",
      "ask": "When an ended off-clock event settles into a closed session, should its Event Task row be completed?",
      "why": "settling exists so off-clock life needs no gestures; [/] would park every lunch in Pending",
      "choices": [
        {
          "key": "done",
          "label": "Completed ([x] + done date), as a timed close completes a meeting that ended inside it"
        },
        {
          "key": "in_progress",
          "label": "Marked [/] like a past row sync creates; you complete or cancel it yourself"
        }
      ],
      "default": "done",
      "effective_default": "done",
      "requested_verified": false
    },
    {
