      "id": "collapse_assist",
      "kind": "toggle",
      "ask": "Should `#`, `/`, `^`, `.`, `+`, or `,` typed right after a complete `@@route` collapse it to `@route#`/`^`/`+`?",
      "why": "Keeps a typed @@foo#bar, @@foo+baz, or @@foo^id working while @@ keeps one meaning",
      "default": true,
      "effective_default": true,
      "requested_verified": false
    },
