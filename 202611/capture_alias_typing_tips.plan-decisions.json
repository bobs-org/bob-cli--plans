      "id": "picker_tip_slot",
      "kind": "choice",
      "ask": "Should picker tips sit at the foot of the picker card, the same slot the completion-list tip uses?",
      "why": "One placement rule for every host, and a not-live key never sits among live key hints",
      "choices": [
        {
          "key": "card_foot",
          "label": "Last line of the picker card under a hairline; the key legend keeps only live keys"
        },
        {
          "key": "key_legend",
          "label": "Extra line under the panel footer's live key hints; picker card height never changes"
        }
      ],
      "default": "card_foot",
      "effective_default": "card_foot",
      "requested_verified": false
