  "definitions": [
    {
      "id": "accounts",
      "kind": "choice",
      "ask": "Which accounts should bank.md track from day one?",
      "why": "The vault shows no card in use, and the old @BANK habit was checking-only",
      "choices": [
        {
          "key": "checking",
          "label": "Wells Fargo checking only; a card is added later with one bank.md entry"
        },
        {
          "key": "checking_card",
          "label": "Also a credit card you spend on, with its card payments marked transfer"
        }
      ],
      "default": "checking",
      "effective_default": "checking",
      "requested_verified": false
    },
    {
      "id": "subscriptions_scope",
      "kind": "choice",
      "ask": "Which recurring charges should the follow-up subscriptions album hold?",
      "why": "Obligations aren't keep-or-cancel choices, and auditing those choices is the album's job",
      "choices": [
        {
          "key": "discretionary",
          "label": "Only keep-or-cancel charges; mortgage, loans, and insurance stay categories"
        },
        {
          "key": "all_recurring",
          "label": "Every recurring charge, so the album also shows a fixed monthly burn"
        }
      ],
      "default": "discretionary",
      "effective_default": "discretionary",
      "requested_verified": false
    },
