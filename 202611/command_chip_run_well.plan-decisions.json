    {
      "id": "copy_only_look",
      "kind": "choice",
      "ask": "Should a command chip that can only copy wear the copy chip's blue well and copy glyph?",
      "why": "The click copies, so the copy look tells the truth and keeps one meaning per hue",
      "choices": [
        {
          "key": "copy",
          "label": "Blue copy well and body, exactly like a copy chip; blue always means a click copies"
        },
        {
          "key": "run",
          "label": "Keeps the purple run body with a muted copy well; blue no longer always means copy"
        }
      ],
      "default": "copy",
      "effective_default": "copy",
      "requested_verified": false
    },
