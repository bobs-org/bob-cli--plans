{
  "schema": 1,
  "definitions": [
    {
      "id": "post_hue",
      "kind": "choice",
      "ask": "Should POST share PRE's cyan, so the review opens and closes in the same checklist color?",
      "why": "PRE/POST are one row kind sharing teal marks in notes; a ninth hue blurs at dot size",
      "choices": [
        {
          "key": "bookends",
          "label": "POST joins PRE's cyan; the walk opens and closes in one hue, PRE/POST text tells them apart"
        },
        {
          "key": "dusk",
          "label": "POST gets its own indigo dusk hue; distinct from PRE, but near TICKLER blue and PROJECTS purple"
        }
      ],
      "default": "bookends",
      "effective_default": "bookends",
      "requested_verified": false
    },
    {
      "id": "s_count",
      "kind": "choice",
      "ask": "Should the Mac `s` mark count every row `]s` can still land on (Bob's walk total)?",
      "why": "one number that drops with every answer and never reads 0 on a lit mark",
      "choices": [
        {
          "key": "walk",
          "label": "The count is the walk total; nonzero exactly when lit, matching the footer's Review r/N"
        },
        {
          "key": "commitments",
          "label": "The count stays the commitment total; a ROTTEN- or POST-only mark shows bare"
        }
      ],
      "default": "walk",
      "effective_default": "walk",
      "requested_verified": false
    },
    {
