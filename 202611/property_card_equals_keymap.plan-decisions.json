{
  "schema": 1,
  "definitions": [
    {
      "id": "habit_guard",
      "kind": "toggle",
      "ask": "Swallow a fast second `=` after a bare `=` opens a card editor, so the old `==` habit opens it once?",
      "why": "every species editor binds bare `=`, so an unguarded `==` habit misfires on the next key",
      "default": true,
      "effective_default": true,
      "requested_verified": false
    },
    {
      "id": "period_callouts",
      "kind": "toggle",
      "ask": "Bump period callouts to v4 so `bob periods ensure -R` can rewrite the ~59 vault callouts that say `==`?",
      "why": "a parenthetical key hint does not justify flagging every unreflected period note stale",
      "default": false,
      "effective_default": false,
      "requested_verified": false
    },
    {
      "id": "memory_glossary_cards",
      "kind": "toggle",
