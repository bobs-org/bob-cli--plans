{
  "schema": 1,
  "definitions": [
    {
      "id": "auto_sync",
      "kind": "toggle",
      "ask": "On the writer Mac, should saving or clearing a note immediately sync each affected day whose daily note exists?",
      "why": "Today's row reflects the note at once instead of waiting for the next sync",
      "default": true,
      "effective_default": true,
      "requested_verified": false
    },
    {
      "id": "mac_chord",
      "kind": "choice",
      "ask": "Which chord should open the Event note mode in Bob Mac Capture?",
      "why": "E for event sits beside \u2318J, and you write notes right after an RSVP, often mid-draft",
      "choices": [
        {
          "key": "cmd_e",
          "label": "\u2318E from any draft; the capture draft waits untouched until you come back"
        },
        {
          "key": "cmd_e_blank",
          "label": "\u2318E only in an empty draft, matching \u2318J's join-event rule"
        },
        {
          "key": "leader",
          "label": "Ctrl-G e under the existing editor leader; adds no new top-level chord"
        }
      ],
      "default": "cmd_e",
      "effective_default": "cmd_e",
      "requested_verified": false
    },
