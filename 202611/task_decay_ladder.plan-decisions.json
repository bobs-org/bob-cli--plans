    {
      "id": "early_keeps",
      "kind": "choice",
      "ask": "How should Alt+F on a WIP or Next task that is not due (early or linked today) behave?",
      "why": "Every entry then marks a real due review, so its count is truthful",
      "choices": [
        {
          "key": "quiet",
          "label": "Stamp quietly with an \"early \u00b7 not counted\" notice; no prompt, no log entry"
        },
        {
          "key": "prompt",
          "label": "Prompt and always log an uncounted \"kept early in Next\" entry; \ud83e\udd37 when blank"
        }
      ],
      "default": "quiet",
      "effective_default": "quiet",
      "requested_verified": false
    },
