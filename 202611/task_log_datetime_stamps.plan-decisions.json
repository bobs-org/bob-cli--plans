{
  "schema": 1,
  "definitions": [
    {
      "id": "schedule_layout",
      "kind": "choice",
      "ask": "Where should a Schedule Log entry's write stamp go?",
      "why": "The reason body stays byte-identical, and old readers keep working during rollout",
      "choices": [
        {
          "key": "inside",
          "label": "Stamp opens the italic lead before the change; the reason body and old readers stay intact"
        },
        {
          "key": "lead",
          "label": "Stamp is the whole italic lead; the change moves into the body and readers must split it off"
        }
      ],
      "default": "inside",
      "effective_default": "inside",
      "requested_verified": false
    },
    {
      "id": "reopen_stamp",
      "kind": "choice",
      "ask": "Which minute should a Reopen Log entry's stamp record?",
      "why": "Stamp = write instant for every log; the alias already shows the arrival minute",
      "choices": [
        {
          "key": "write",
          "label": "The minute bob gmail sync writes the entry; the card alias still shows the message's minute"
        },
        {
          "key": "message",
          "label": "The message's arrival minute, repeating the card alias's time"
        }
      ],
      "default": "write",
      "effective_default": "write",
      "requested_verified": false
    },
    {
